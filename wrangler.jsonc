// Cloudflare Workers static assets: serves the Vite build from dist/.
// public/_headers is copied into dist and applied by Cloudflare.
{
  "name": "macrochef-academy",
  "compatibility_date": "2025-09-01",
  // The public address is macrochef-academy.macrochef.workers.dev; no per-version preview links.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
